# Copy to .env and fill in. All keys are free; any you leave empty just disables that source.
# These are read by the dev proxy (vite.config.ts) and by nginx in Docker — never bundled into the browser.

# https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=
# https://developer.nytimes.com/get-started  (enable "Article Search API")
NYT_API_KEY=
# https://newsapi.org/register
NEWSAPI_API_KEY=
